# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Porta do Servidor HTTP/Express (padrão 3000 no Google AI Studio, pode definir 3001 em PRD)
PORT=3000

# Porta do Servidor TCP MLLP para Comunicação com Equipamentos
TCP_PORT=5151

# Configuração do Banco de Dados MySQL
DB_HOST="186.237.152.170"
DB_USER="inovalab"
DB_PASSWORD="inovalab"
DB_NAME="interface-db"
DB_PORT="3306"
DB_PROVIDER=mysql

# Endpoints da API REST do LIS Externo
LIS_REST_SAMPLE_URL="http://186.237.152.170:3000/api/amostra"
LIS_REST_PRIMARY_URL="http://186.237.152.170:3000/api/amostra/resultado"
LIS_REST_SECONDARY_URL="http://186.237.152.170:3000/api/interfaceamento/amostra/resultado"
